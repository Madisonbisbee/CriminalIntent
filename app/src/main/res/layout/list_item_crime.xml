<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/crime_card_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/crimePhoto"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/photo_background"
        android:contentDescription="Crime photo"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_camera" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/crimeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crime Title"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/crimeDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="October 11, 2026"
            android:textColor="#666666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/crimeSolved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Unsolved"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>